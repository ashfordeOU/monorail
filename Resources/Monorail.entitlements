<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The camera tile and (opt-in) head focus. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Voice commands, only while you hold the voice command. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Scripts run in JavaScriptCore. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Snapshots that save browser tabs and Finder windows (opt-in). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The folder Ashforde's apps share (Monorail and Keeper talk through it inside the sandbox). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>D69G45342Y.group.ashforde.suite</string>
	</array>
	<!-- Calendar and Reminders (the hardened runtime refuses them silently without these). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.reminders</key>
	<true/>
</dict>
</plist>

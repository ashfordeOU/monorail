<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store edition runs in Apple's sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Anonymous usage counts, app quirks updates and the optional Claude assistant. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The camera tile and (opt-in) head focus. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Voice commands, only while you hold the voice command. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Opening and saving .monorail layout files you choose. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remembering a folder you chose (Storage), across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Listing paired Bluetooth accessories (batteries). -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Calendar events for meeting layouts. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- The folder Ashforde's apps share (Monorail and Keeper talk through it inside the sandbox). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>D69G45342Y.group.ashforde.suite</string>
	</array>
</dict>
</plist>

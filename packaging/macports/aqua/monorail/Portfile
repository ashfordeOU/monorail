PortSystem          1.0
PortGroup           github 1.0

github.setup        ashfordeOU monorail 1.7.13 v
github.tarball_from releases
revision            0

name                monorail
categories          aqua
platforms           {darwin >= 22}
supported_archs     arm64 x86_64
license             Restrictive/Distributable
maintainers         nomaintainer

description         Scrolling window manager for macOS
long_description    Monorail by Ashforde® puts every window on one endless strip, so new windows \
                    slide in beside you and nothing you're using ever shrinks. Drag windows onto \
                    each other to dock or tab them, type what you want in plain words, and save \
                    views to jump back to.
homepage            https://ashfordeou.github.io/monorail/

# A universal, signed app from the release (building needs the full Xcode toolchain).
distname            Monorail-${version}
use_zip             yes
extract.mkdir       yes
checksums           rmd160  839653bf4890eb873968d306bcf3113d5fcbc452 \
                    sha256  34b618fdb4fcb2400e4d11fa0155a6c734c73e79912bb161e32a62a9bfc95d20 \
                    size    6853682

use_configure       no
build               {}

destroot {
    copy ${worksrcpath}/Monorail.app ${destroot}${applications_dir}/Monorail.app
}

notes "
Open Monorail from Applications and allow Accessibility access when asked.
Monorail updates itself; MacPorts upgrades it too when the port is updated.
"
